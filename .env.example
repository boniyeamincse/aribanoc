# ============================================================
#  Ariba NOC Center — Environment Variables
#  Copy this to .env and fill in your values
# ============================================================

# Global
TZ=Asia/Dhaka

# ── Zabbix ────────────────────────────────────────────────
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=CHANGE_zabbix_db_password
ZABBIX_SERVER_NAME=zabbix-server
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=CHANGE_zabbix_admin_password

# ── Grafana ───────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_grafana_admin_password
GF_SERVER_ROOT_URL=http://localhost:3000/

# ── Prometheus ────────────────────────────────────────────
PROMETHEUS_RETENTION=30d

# ── ELK ───────────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_elastic_password

# ── LibreNMS ──────────────────────────────────────────────
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=librenms
LIBRENMS_DB_PASSWORD=CHANGE_librenms_db_password
LIBRENMS_SNMP_COMMUNITY=public

# ── NetBox ────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
NETBOX_SECRET_KEY=CHANGE_netbox_secret_key_generate_a_random_50char_string
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=CHANGE_netbox_db_password

# ── Alert / Notification Channels ────────────────────────
# Telegram: create a bot via @BotFather, get token + chat_id
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Email (SMTP)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_FROM=noc@example.com
ALERT_EMAIL_TO=oncall@example.com


# Ariba NOC Center - Custom Suricata Rules
# Place your site-specific detection rules here.
# Syntax: action proto src_ip src_port direction dest_ip dest_port (options)

# ── Example: Detect ICMP flood ────────────────────────────────────────────────
alert icmp any any -> $HOME_NET any (msg:"ICMP Flood Detected"; threshold: type threshold, track by_src, count 100, seconds 10; classtype:denial-of-service; sid:9000001; rev:1;)

# ── Example: Detect port scan ─────────────────────────────────────────────────
alert tcp any any -> $HOME_NET any (msg:"Possible Port Scan"; flags:S; threshold: type threshold, track by_src, count 20, seconds 5; classtype:network-scan; sid:9000002; rev:1;)

# ── Example: Detect SSH brute force ──────────────────────────────────────────
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flow:to_server,established; threshold: type threshold, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:9000003; rev:1;)

# ── Example: Detect HTTP scanning tools ──────────────────────────────────────
alert http any any -> $HTTP_SERVERS any (msg:"HTTP Scanner Tool Detected - nikto"; flow:to_server,established; http.user_agent; content:"nikto"; nocase; classtype:web-application-attack; sid:9000004; rev:1;)
alert http any any -> $HTTP_SERVERS any (msg:"HTTP Scanner Tool Detected - sqlmap"; flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000005; rev:1;)

# ── Example: Detect DNS exfiltration (high query rate) ───────────────────────
alert dns any any -> any 53 (msg:"Possible DNS Exfiltration - High Query Rate"; threshold: type threshold, track by_src, count 50, seconds 10; classtype:policy-violation; sid:9000006; rev:1;)

# ── Example: Detect cleartext password (FTP) ─────────────────────────────────
alert tcp any any -> $FTP_SERVERS $FTP_PORTS (msg:"FTP Login Attempt"; flow:to_server,established; content:"USER "; nocase; classtype:policy-violation; sid:9000007; rev:1;)

# ── Example: Detect Telnet usage (insecure) ──────────────────────────────────
alert tcp any any -> $TELNET_SERVERS 23 (msg:"Telnet Connection Detected - Insecure Protocol"; flow:to_server,established; classtype:policy-violation; sid:9000008; rev:1;)

# ── Example: Detect outbound connections to known bad ports ──────────────────
alert tcp $HOME_NET any -> $EXTERNAL_NET [4444,1337,31337] (msg:"Possible C2 Communication - Common Backdoor Port"; flow:to_server,established; classtype:trojan-activity; sid:9000009; rev:1;)

# ── Example: Detect large data transfer (potential exfiltration) ──────────────
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Large Outbound Data Transfer"; flow:to_server,established; dsize:>65535; threshold: type threshold, track by_src, count 5, seconds 60; classtype:policy-violation; sid:9000010; rev:1;)
